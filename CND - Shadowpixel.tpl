___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Required GTM functions and utilities
const sendPixel = require('sendPixel');
const copyFromWindow = require('copyFromWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const encodeUriComponent = require('encodeUriComponent');
const JSON = require('JSON');
const getUrl = require('getUrl');
const getCookieValues = require('getCookieValues');
const setCookie = require('setCookie');
const logToConsole = require('logToConsole');
const getTimestampMillis = require('getTimestampMillis');

// Extract values from GTM and window
const dataLayer = copyFromWindow('dataLayer');
const gtmId = copyFromDataLayer('gtm.uniqueEventId');
const endPoint = data.endPoint;
const domain = data.domain;
const section = data.section;
const userAgent = data.userAgent;

let latestEntry = {};
let obj = [];

// 🔍 Find the latest entry in dataLayer matching the current GTM event ID
if (dataLayer && gtmId) {
  obj = dataLayer.map(function(o) {
    if (!o || typeof o !== 'object') return {};

    if (o['gtm.uniqueEventId']) return o;

    let clone = {};
    for (let k in o) {
      clone[k] = o[k];
    }

    for (let prop in clone) {
      return clone[prop];
    }

    return {};
  }).filter(function(o) {
    return o && o['gtm.uniqueEventId'] === gtmId;
  });
}

latestEntry = obj.length ? obj[0] : {};

// ─────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────

function getQueryParam(url, param) {
  if (!url) return null;
  var queryIndex = url.indexOf('?');
  if (queryIndex === -1) return null;

  var query = url.substring(queryIndex + 1).split('&');
  for (var i = 0; i < query.length; i++) {
    var pair = query[i].split('=');
    if (pair[0] === param) {
      return pair[1] || '';
    }
  }
  return null;
}

var sessionCounter = 0;

function generateSessionId() {
  sessionCounter++;
  return (
    'dlm_' +
    getTimestampMillis() +
    '_' +
    sessionCounter
  );
}


// 🖥️ Browser detection
function getBrowser(ua) {
  if (!ua) return 'unknown';
  if (ua.indexOf("Opera") !== -1 || ua.indexOf("OPR") !== -1) return 'Opera';
  if (ua.indexOf("Edg") !== -1) return 'Edge';
  if (ua.indexOf("Chrome") !== -1) return 'Chrome';
  if (ua.indexOf("Safari") !== -1) return 'Safari';
  if (ua.indexOf("Firefox") !== -1) return 'Firefox';
  if (ua.indexOf("MSIE") !== -1 || ua.indexOf("Trident") !== -1) return 'IE';
  return 'unknown';
}

// 📱 Device detection
function getDeviceType() {
  var ua = userAgent;
  if (!ua) return "unknown";
  ua = ua.toLowerCase();

  if (
    ua.indexOf("tablet") !== -1 ||
    ua.indexOf("ipad") !== -1 ||
    ua.indexOf("playbook") !== -1 ||
    ua.indexOf("silk") !== -1 ||
    (ua.indexOf("android") !== -1 && ua.indexOf("mobi") === -1)
  ) {
    return "tablet";
  }

  if (
    ua.indexOf("mobile") !== -1 ||
    ua.indexOf("iphone") !== -1 ||
    ua.indexOf("ipod") !== -1 ||
    ua.indexOf("android") !== -1
  ) {
    return "mobile";
  }

  return "desktop";
}

// ─────────────────────────────────────────────
// Live session logic
// ─────────────────────────────────────────────
var LIVE_COOKIE_NAME = 'dlm_live_session_id';

function getLiveSessionId() {
  var values = getCookieValues(LIVE_COOKIE_NAME);
  return values && values.length ? values[0] : null;
}


var url = getUrl();
var liveParam = getQueryParam(url, 'dlm_live_session');
var liveSessionIdParam = getQueryParam(url, 'dlm_live_session_id');
var liveSessionId = getLiveSessionId();

if ((liveParam === 'true' || liveSessionIdParam)) {
  liveSessionId = generateSessionId();
  if (liveSessionIdParam) {
  liveSessionId = liveSessionIdParam;
  }
  setCookie(LIVE_COOKIE_NAME, liveSessionId, {
    'max-age': 60 * 60,
    'path': '/'
  });
}

var isLiveSession = !!liveSessionId;

// 📡 Construct the payload
const dataLayerPayload = latestEntry ? JSON.stringify(latestEntry) : '{}';

var payload = {
  event: latestEntry['event'] || 'unknown',
  domain: domain,
  url: url,
  device_type: getDeviceType(),
  browser: getBrowser(userAgent),
  section: section,
  datalayer_payload: dataLayerPayload
};

if (isLiveSession) {
payload.session_id = liveSessionId;
payload.session_start_timestamp = liveSessionId;
}

// 🔗 Build query string
var queryString = '';
for (var key in payload) {
  if (queryString !== '') {
    queryString += '&';
  }
  queryString += encodeUriComponent(key) + '=' + encodeUriComponent(payload[key]);
}

// 📡 Endpoint switch
var endpointPath = isLiveSession ? '/datalayers-img-live/?': '/datalayers-img/?';
var pixelUrl = endPoint + '/' + domain + endpointPath + queryString;
if (endPoint.indexOf('collect.cloudninedigital.nl') == -1) {
  pixelUrl = endPoint + endpointPath + queryString;
}

// 🧪 Log live events
if (isLiveSession) {
  logToConsole('DLM LIVE EVENT', {
    endpoint: pixelUrl,
    payload: payload
  });
}

// 📨 Send pixel
sendPixel(pixelUrl, function() {
  data.gtmOnSuccess();
}, function() {
  data.gtmOnFailure();
});


